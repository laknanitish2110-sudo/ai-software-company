# === Multi-Provider API Keys ===
# Set the keys for providers you want to use. The model router picks the
# best available provider per agent automatically.
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENAI_API_KEY=sk-proj-your-openai-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
GEMINI_API_KEY=your-gemini-key-here
TAVILY_API_KEY=tvly-your-key-here

# Base URLs (usually no need to change)
LLM_BASE_URL=https://openrouter.ai/api/v1

# Default models (used as fallback when no per-agent override is set)
SMART_MODEL=anthropic/claude-sonnet-4
FALLBACK_MODEL=google/gemini-2.5-flash

# Deployment
FRONTEND_URL=https://your-app.vercel.app
DATABASE_PATH=company.db
N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook/ai-company

# === Recommended Per-Agent Model Config ===
# Each agent uses the best model for its job.
# The system auto-detects available API keys and routes accordingly.
# Only override these if you want something specific.
#
# MODEL_CEO=openai/gpt-4.1              # High-level reasoning, decomposition
# MODEL_BA=openai/gpt-4.1               # Requirements, constraints, trade-offs
# MODEL_RESEARCHER=google/gemini-2.5-pro # Long-context research + synthesis
# MODEL_ARCHITECT=anthropic/claude-sonnet-4  # System design + reasoning
# MODEL_ENGINEER=openai/gpt-4.1         # Agentic coding
# MODEL_PPT=google/gemini-2.5-flash     # Fast content generation
# MODEL_REVIEW=anthropic/claude-sonnet-4 # Code review, specification adherence
# MODEL_FIXER=openai/gpt-4.1            # Bug fixing, repair

# === Per-Agent Provider Routing ===
# Provider: "openrouter" | "openai" | "anthropic" | "gemini"
# Auto-detected from API keys — only override if needed.
# PROVIDER_CEO=openai
# PROVIDER_BA=openai
# PROVIDER_RESEARCHER=gemini
# PROVIDER_ARCHITECT=anthropic
# PROVIDER_ENGINEER=openai
# PROVIDER_PPT=gemini
# PROVIDER_REVIEW=anthropic

# === Fallback Models (used after 3 retries on primary) ===
# FALLBACK_CEO=google/gemini-2.5-flash
# FALLBACK_ENGINEER=anthropic/claude-sonnet-4

# === OAuth Providers (optional — social login) ===
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
BACKEND_URL=http://localhost:8000
