# === Multi-Provider API Keys ===
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENAI_API_KEY=sk-proj-your-openai-key-here
GEMINI_API_KEY=your-gemini-key-here
TAVILY_API_KEY=tvly-your-key-here

# Base URLs (usually no need to change)
LLM_BASE_URL=https://openrouter.ai/api/v1

# Default model (used when no per-agent override is set)
SMART_MODEL=anthropic/claude-sonnet-4
FALLBACK_MODEL=google/gemini-2.5-flash

# Deployment
FRONTEND_URL=https://your-app.vercel.app
DATABASE_PATH=company.db
N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook/ai-company

# === Per-Agent Provider Routing ===
# Provider: "openrouter" | "openai" | "gemini"
# PROVIDER_CEO=openrouter
# PROVIDER_BA=openrouter
# PROVIDER_RESEARCHER=openrouter
# PROVIDER_ARCHITECT=openrouter
# PROVIDER_ENGINEER=openai
# PROVIDER_PPT=openrouter
# PROVIDER_REVIEW=openrouter

# === Per-Agent Model Overrides ===
# MODEL_CEO=google/gemini-2.5-flash
# MODEL_BA=anthropic/claude-sonnet-4
# MODEL_RESEARCHER=google/gemini-2.5-flash
# MODEL_ARCHITECT=anthropic/claude-sonnet-4
# MODEL_ENGINEER=gpt-4o
# MODEL_PPT=google/gemini-2.5-flash
# MODEL_REVIEW=google/gemini-2.5-flash

# === Fallback Models (used after 3 retries on primary) ===
# FALLBACK_CEO=google/gemini-2.5-flash
# FALLBACK_ENGINEER=anthropic/claude-sonnet-4
