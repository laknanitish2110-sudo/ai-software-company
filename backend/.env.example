# === API Keys ===
# OpenRouter free tier — the primary provider. Get keys at openrouter.ai
# Multiple keys = one dedicated key per agent, zero rate-limit sharing.
OPENROUTER_API_KEY=sk-or-v1-your-key-here
# OPENROUTER_API_KEY_2=sk-or-v1-second-key
# OPENROUTER_API_KEY_3=sk-or-v1-third-key
# OPENROUTER_API_KEY_4=sk-or-v1-fourth-key
# OPENROUTER_API_KEY_5=sk-or-v1-fifth-key
# OPENROUTER_API_KEY_6=sk-or-v1-sixth-key

TAVILY_API_KEY=tvly-your-key-here

# Base URLs (usually no need to change)
LLM_BASE_URL=https://openrouter.ai/api/v1

# Default models — best free models
SMART_MODEL=deepseek/deepseek-chat-v3-0324:free
FALLBACK_MODEL=nvidia/nemotron-3.5-lightning:free

# Deployment
FRONTEND_URL=https://your-app.vercel.app
DATABASE_PATH=company.db
N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook/ai-company

# === Free Per-Agent Model Config ===
# DeepSeek V3 (671B MoE) — best free model for reasoning + coding
# Nemotron 120B — strong analysis, large context
# Nemotron Lightning — fast, good for simple generation
#
# MODEL_CEO=deepseek/deepseek-chat-v3-0324:free
# MODEL_BA=nvidia/nemotron-3-super-120b-a12b:free
# MODEL_RESEARCHER=nvidia/nemotron-3-super-120b-a12b:free
# MODEL_ARCHITECT=deepseek/deepseek-chat-v3-0324:free
# MODEL_ENGINEER=deepseek/deepseek-chat-v3-0324:free
# MODEL_PPT=nvidia/nemotron-3.5-lightning:free
# MODEL_REVIEW=nvidia/nemotron-3-super-120b-a12b:free
# MODEL_FIXER=deepseek/deepseek-chat-v3-0324:free

# === Optional paid provider keys (not required) ===
# If you add these, the router can use direct provider APIs.
# OPENAI_API_KEY=sk-proj-your-openai-key-here
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
# GEMINI_API_KEY=your-gemini-key-here

# === OAuth Providers (optional — social login) ===
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
BACKEND_URL=http://localhost:8000
