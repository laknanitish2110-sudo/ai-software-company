# === API Keys ===
# OpenRouter free tier — the primary provider. Get keys at openrouter.ai
# Multiple keys = one dedicated key per agent, zero rate-limit sharing.
OPENROUTER_API_KEY=sk-or-v1-your-key-here
# OPENROUTER_API_KEY_2=sk-or-v1-second-key
# OPENROUTER_API_KEY_3=sk-or-v1-third-key
# OPENROUTER_API_KEY_4=sk-or-v1-fourth-key
# OPENROUTER_API_KEY_5=sk-or-v1-fifth-key
# OPENROUTER_API_KEY_6=sk-or-v1-sixth-key

# Nvidia (build.nvidia.com) — 80+ free models, direct API
NVIDIA_API_KEY=nvapi-your-key-here
# Groq (console.groq.com) — ultra-fast free inference
GROQ_API_KEY=gsk_your-key-here

TAVILY_API_KEY=tvly-your-key-here

# Base URLs (usually no need to change)
LLM_BASE_URL=https://openrouter.ai/api/v1

# Default models — best free models
SMART_MODEL=deepseek/deepseek-chat-v3-0324:free
FALLBACK_MODEL=nvidia/nemotron-3.5-lightning:free

# Deployment
FRONTEND_URL=https://your-app.vercel.app
DATABASE_PATH=company.db
N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook/ai-company

# === Per-Agent Model + Provider Routing ===
# Spread agents across 3 providers: OpenRouter, Groq, Nvidia
# This avoids rate limits and uses each provider's strengths.

# CEO: Fast briefs — Groq (speed)
PROVIDER_CEO=groq
MODEL_CEO=llama-3.3-70b-versatile

# BA: Structured requirements — OpenRouter (DeepSeek V3, strongest reasoning)
PROVIDER_BA=openrouter
MODEL_BA=deepseek/deepseek-chat-v3-0324:free

# Researcher: Data synthesis — OpenRouter (Nemotron 120B)
PROVIDER_RESEARCHER=openrouter
MODEL_RESEARCHER=nvidia/nemotron-3-super-120b-a12b:free

# Architect: Technical design — Nvidia (Nemotron Ultra 253B)
PROVIDER_ARCHITECT=nvidia
MODEL_ARCHITECT=nvidia/llama-3.1-nemotron-ultra-253b-v1

# Engineer: Code generation — OpenRouter (DeepSeek V3)
PROVIDER_ENGINEER=openrouter
MODEL_ENGINEER=deepseek/deepseek-chat-v3-0324:free

# PPT: Slides — Groq (speed)
PROVIDER_PPT=groq
MODEL_PPT=llama-3.3-70b-versatile

# Reviews: Short evaluations — Groq (fast)
PROVIDER_REVIEW=groq
MODEL_REVIEW=llama-3.3-70b-versatile

# Fixer: Code repair — OpenRouter (DeepSeek V3)
PROVIDER_FIXER=openrouter
MODEL_FIXER=deepseek/deepseek-chat-v3-0324:free

# === Optional paid provider keys ===
# OPENAI_API_KEY=sk-proj-your-openai-key-here
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
# GEMINI_API_KEY=your-gemini-key-here

# === OAuth Providers (optional — social login) ===
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
BACKEND_URL=http://localhost:8000
